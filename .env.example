# Local PostgreSQL 16. Replace credentials and require verified TLS in AWS.
DATABASE_URL=postgresql+psycopg://dabom:dabom-local@127.0.0.1:54329/dabom

# Comma-separated browser application origins.
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_SESSION_COOKIE=dabom_session
AUTH_CSRF_COOKIE=dabom_csrf
AUTH_COOKIE_SECURE=false

# React uses the live HTTP adapter by default. Keep the CSRF cookie names equal.
VITE_APP_MODE=live
VITE_AUTH_CSRF_COOKIE=dabom_csrf

# First administrator for a server nobody can run `./dev.sh admin` on.
# Read only while no administrator exists; ignored afterwards, so it never resets
# a password. Password: 10+ characters, different from the username.
# Sign in, change the password, then delete both lines.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Interview model configuration.
OPENAI_API_KEY=
INTERVIEW_MODEL=openai:gpt-4.1-mini
INTERVIEW_BASE_URL=
INTERVIEW_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
