# Local PostgreSQL 16. Replace credentials and require verified TLS in AWS.
DATABASE_URL=postgresql+psycopg://dabom:dabom-local@127.0.0.1:54329/dabom

# Comma-separated browser application origins.
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_SESSION_COOKIE=dabom_session
AUTH_CSRF_COOKIE=dabom_csrf
AUTH_COOKIE_SECURE=false

# Interview model configuration.
OPENAI_API_KEY=
INTERVIEW_MODEL=openai:gpt-4.1-mini
LANGSMITH_TRACING=false
