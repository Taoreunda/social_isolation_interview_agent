# Copy to deploy/.env on the server (server-setup.sh does it and fills in the
# database password). Never commit the copy.

# --- Database -------------------------------------------------------------
# PostgreSQL in a container on the same instance. Letters and digits only in
# the password: it is also part of DATABASE_URL.
COMPOSE_PROFILES=localdb
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://dabom:change-me@db:5432/dabom
# With RDS: remove COMPOSE_PROFILES and POSTGRES_PASSWORD, and use
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@RDS-ENDPOINT:5432/dabom?sslmode=verify-full&sslrootcert=/path/to/rds-ca.pem

# --- Address ----------------------------------------------------------------
# First smoke test, plain HTTP on the instance address (test data only):
SITE_ADDRESS=:80
AUTH_ALLOWED_ORIGINS=http://YOUR.EC2.IP.ADDRESS
AUTH_COOKIE_SECURE=false
# With a domain (required before real participants): Caddy gets HTTPS itself.
# SITE_ADDRESS=interview.example.org
# AUTH_ALLOWED_ORIGINS=https://interview.example.org
# AUTH_COOKIE_SECURE=true

AUTH_SESSION_COOKIE=dabom_session
AUTH_CSRF_COOKIE=dabom_csrf

# --- First administrator ----------------------------------------------------
# Read only while no administrator exists. Sign in, change the password, then
# delete both lines and deploy again.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Interview model --------------------------------------------------------
OPENAI_API_KEY=
INTERVIEW_MODEL=openai:gpt-4.1-mini
INTERVIEW_BASE_URL=
INTERVIEW_API_KEY=
LANGSMITH_TRACING=false
