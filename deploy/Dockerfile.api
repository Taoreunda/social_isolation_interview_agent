# FastAPI + Alembic. Built from the repository root: see deploy/compose.yaml.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.9.18 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Dependencies first, so a code change does not reinstall them.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY alembic.ini interview_flow.json ./
COPY backend ./backend

RUN useradd --system --uid 10001 --no-create-home app
USER app

EXPOSE 8000

# The same migrations as local development, applied before the application starts.
# One worker on purpose: overlapping interview turns are refused by an in-process lock.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn api:app --app-dir backend --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips='*'"]
